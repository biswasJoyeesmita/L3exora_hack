# YouTube Data API v3 Key (for comment ingestion)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Google Gemini API Key (for LLM sentiment classification & topic summary)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (optional fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Lexora Internal Shared Secret (for protecting report generation & audit routes)
LEXORA_API_KEY=your_random_secure_hex_key_here
